# Copie para .dev.vars (desenvolvimento local). Nunca versione valores reais.
# Em produção, os campos marcados [secret] vão como Secret (ver docs/DEPLOY-TESTE.md).

AMBIENTE=desenvolvimento
# Só vale com AMBIENTE=desenvolvimento E acesso por localhost (pula o login).
# Deixe vazio para testar o login real localmente.
DEV_EMAIL=dev@exemplo.local

# [secret] Lista de usuários: gerada por `npm run usuarios -- publicar --local`
USUARIOS=
# [secret] Texto aleatório com no mínimo 32 caracteres
SESSION_SECRET=

OPENAI_MODEL=
# [secret] Use uma chave de projeto de DESENVOLVIMENTO, com limite de gasto baixo.
OPENAI_API_KEY=
