{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financeirospl",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-10",
  "upload_source_maps": true,

  // App publicado em *.workers.dev. O login (nome + senha gerada) é do próprio app.
  // Ao migrar para domínio próprio: configurar "routes".
  "workers_dev": true,
  // Preview URLs desligadas: versões antigas não devem ficar acessíveis por outros endereços.
  "preview_urls": false,
  // Configure a rota do domínio privado aqui quando ele existir, ex.:
  // "routes": [{ "pattern": "financeiro.exemplo.com.br", "custom_domain": true }],

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Somente logs explícitos do código (categorias de erro). Invocation logs desligados
  // para não registrar metadados de requisição além do necessário.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },

  // Guarda apenas contadores por usuário, nunca conteúdo.
  "ratelimits": [
    { "name": "LIMITADOR", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],

  // Valores de produção. Em desenvolvimento local são sobrescritos por .dev.vars.
  // Secrets (nunca aqui):
  //   USUARIOS        → npm run usuarios -- publicar
  //   SESSION_SECRET  → npx wrangler secret put SESSION_SECRET
  //   OPENAI_API_KEY  → npx wrangler secret put OPENAI_API_KEY
  "vars": {
    "AMBIENTE": "producao",
    "OPENAI_MODEL": ""
  }
}
